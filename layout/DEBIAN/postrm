#!/bin/sh
# The tweak's hooks live in eyereliefd on iOS 17+ and in backboardd on iOS 16
# (Darwin 22 = iOS 16, 23 = iOS 17). Package managers restart neither, and an
# already running one would keep going without (or with the old) tweak.
# SIGKILL, because both use transactions and can sit on a SIGTERM; launchd
# relaunches them. Killing backboardd respring the device.
if [ "$(uname -r | cut -d. -f1)" -ge 23 ]; then
	daemon=eyereliefd
else
	daemon=backboardd
fi
killall -9 "$daemon" 2>/dev/null

# debug logs (ScreenDistancePillLog.m tries these three directories, inside
# the jailbreak root: "" on roothide, /var/jb on rootless). Only when the
# package is really removed, not on an upgrade.
case "$1" in
remove|purge)
	for root in "" /var/jb; do
		rm -rf "$root/var/mobile/Library/Caches/ScreenDistancePill" \
			"$root/var/mobile/Library/ScreenDistancePill" \
			"$root/var/tmp/ScreenDistancePill"
	done
	;;
esac
exit 0
